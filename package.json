{
  "name": "ranterra",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "test:rust": "cargo test --workspace",
    "test:wasm": "node scripts/test-wasm.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:worker": "node scripts/test-worker.mjs",
    "test": "npm run test:rust && npm run test:wasm && npm run test:worker && npm run test:replay",
    "format": "prettier --write src/*.ts src/*.tsx src/*.css scripts/*.mjs README.md docs/*.md && cargo fmt --all",
    "lint": "eslint src tests scripts *.ts *.js",
    "typecheck": "tsc -b",
    "test:browser": "playwright test",
    "benchmark": "cargo run --release -p ranterra-engine --example benchmark",
    "benchmark:wasm": "node scripts/benchmark-wasm.mjs",
    "test:replay": "node scripts/test-replay.mjs",
    "test:protocols": "sh scripts/validate-protocols.sh"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/layers": "^9.2.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@loaders.gl/core": "4.3.4",
    "@loaders.gl/images": "4.3.4",
    "@loaders.gl/schema": "4.3.4",
    "@loaders.gl/worker-utils": "4.3.4",
    "@loaders.gl/loader-utils": "4.3.4"
  }
}
