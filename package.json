{
  "name": "ranterra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "test:rust": "cargo test --workspace",
    "test:wasm": "node scripts/test-wasm.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:worker": "node scripts/test-worker.mjs",
    "test": "npm run test:rust && npm run test:wasm && npm run test:worker",
    "format": "prettier --write src/*.ts src/*.tsx src/*.css scripts/*.mjs README.md docs/*.md && cargo fmt --all"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/layers": "^9.2.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@loaders.gl/core": "4.3.4",
    "@loaders.gl/images": "4.3.4",
    "@loaders.gl/schema": "4.3.4",
    "@loaders.gl/worker-utils": "4.3.4",
    "@loaders.gl/loader-utils": "4.3.4"
  }
}
